NEXT_PUBLIC_APP_NAME=Fycbit
NEXT_PUBLIC_APP_TITLE=Fycbit Development
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_HOSTED_CLIENT_URL=http://localhost:3000/
NEXT_PUBLIC_HOST_SOCKET=127.0.0.1
NEXT_PUBLIC_WSS_PORT=6001
NEXT_PUBLIC_DEMO_MODE=1

NEXT_PUBLIC_SEO_TITLE=Fycbit Development
NEXT_PUBLIC_SEO_DES=Local development environment
NEXT_PUBLIC_SEO_KEYWORDS=development,testnet
NEXT_PUBLIC_FAVICON=/favicon.ico

# Browser-visible compatibility values. These are NOT secrets.
# The application must be redesigned before using either value as authentication.
NEXT_PUBLIC_SECRET_KEY=public-development-placeholder
NEXT_PUBLIC_EVM_APP_HOST=
NEXT_PUBLIC_EVM_APP_SECRET=public-development-placeholder

# Optional public client identifiers. Leave empty when features are disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
NEXT_PUBLIC_PAYPAL_CLIENT_KEY=
NEXT_PUBLIC_PUBLISH_KEY=
NEXT_PUBLIC_CRISP_ID=

