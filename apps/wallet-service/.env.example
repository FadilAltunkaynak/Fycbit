NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://fycbit:replace_with_local_password@127.0.0.1:3306/fycbit

JWT_SECRET=replace_with_a_long_random_local_value
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=dev@example.invalid

# Development placeholders only. Do not configure mainnet keys.
API_SECRET=replace_with_random_local_value
BLOCK_PROCESSOR_STATUS=disabled
BLOCK_PROCESSOR_DEBUG_LOG=false
SOLANA_BLOCK_PROCESSING_STATUS=disabled
EVM_BLOCK_CONFIRMATION=12
SOLANA_BLOCK_CONFIRMATION=32
TRON_BLOCK_CONFIRMATION=20
TRC_BLOCK_NUMBER=0

